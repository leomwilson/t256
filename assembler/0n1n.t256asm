# accepts strings of the form 0^n 1^n
# e.g. "000111", "01", ""
# rejects e.g. "hello", "011", "0101", "0011a"
02, 30 -> 03, 00, R;
03, 30 -> 03, 30, R;
03, 31 -> 03, 31, R;
03, 00 -> 04, 00, L;
04, 31 -> 05, 00, L;
05, 31 -> 05, 31, L;
05, 30 -> 05, 30, L;
05, 00 -> 02, 00, R;
02, 00 -> 01, 00, R;
# reject if it doesn't match this pattern